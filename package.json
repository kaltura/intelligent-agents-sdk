{
  "name": "@kaltura/intelligent-agents",
  "version": "1.23.0",
  "private": true,
  "description": "Zero-dependency SDK for Kaltura conversational avatar agents — Management (provision/configure/measure) + Experience (live interactive runtime). Grounded only in what the public APIs deliver today.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./management": "./src/management/index.js",
    "./experience": "./src/experience/index.js",
    "./experience/presenter": "./src/experience/presenter.js",
    "./experience/site-nav": "./src/experience/site-nav.js",
    "./experience/chroma-key": "./src/experience/chroma-key.js",
    "./experience/genui": "./src/experience/genui/index.js",
    "./experience/noise-suppressor": "./src/experience/noise-suppressor.js",
    "./experience/analytics": "./src/experience/analytics.js",
    "./test/fakes/*": "./test/fakes/*"
  },
  "files": [
    "src",
    "examples",
    "test/fakes",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:evals": "node --test test/evals/*.test.js",
    "test:ci": "node --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=88 --test-coverage-branches=80 --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.junit.xml 'test/**/*.test.js'",
    "verify": "node scripts/agent_verify.mjs",
    "docs:gate": "node tools/check-docs.mjs",
    "harness": "node scripts/harness/run.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "circular": "madge --circular --extensions js src/",
    "harness:constitution": "node tools/constitution-harness.mjs",
    "sri:map": "node tools/sri-map.mjs",
    "live-verify:browser": "node scripts/live-verify-browser.mjs",
    "live-verify:avatar-media": "node scripts/live-verify-avatar-media.mjs",
    "live-verify:request-vars": "node scripts/live-verify-request-vars.mjs",
    "live-verify:context-fields": "node scripts/live-verify-context-fields.mjs",
    "live-verify:capabilities": "node scripts/live-verify-capabilities.mjs",
    "live-verify:conversation-surface": "node scripts/live-verify-conversation-avatar-surface.mjs",
    "live-verify:session-complete": "node scripts/live-verify-session-complete.mjs",
    "live-verify:site-nav": "node scripts/live-verify-site-nav.mjs",
    "live-verify:force-language": "node scripts/live-verify-force-language.mjs",
    "live-verify:set-forced-language": "node scripts/live-verify-set-forced-language.mjs",
    "live-verify:threads-messages-feedback": "node scripts/live-verify-threads-messages-feedback.mjs",
    "live-verify:skills": "node scripts/live-verify-skills.mjs",
    "live-verify:catalog": "node scripts/live-verify-catalog.mjs",
    "live-verify:knowledge": "node scripts/live-verify-knowledge.mjs",
    "live-verify:avatars": "node scripts/live-verify-avatars.mjs",
    "live-verify:agents": "node scripts/live-verify-agents.mjs",
    "live-verify:intellects-conversations": "node scripts/live-verify-intellects-conversations.mjs",
    "live-verify:tools": "node scripts/live-verify-tools.mjs",
    "live-verify:kickoff": "node scripts/live-verify-kickoff.mjs",
    "live-verify:opening-phrase": "node scripts/live-verify-opening-phrase.mjs",
    "live-verify:connect-timing": "node scripts/live-verify-connect-timing.mjs",
    "verify:noise-suppressor": "node scripts/verify-noise-suppressor.mjs",
    "verify:avatar-media": "node scripts/verify-avatar-media.mjs",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "test:ci:avatar-media": "node --experimental-test-coverage --test-coverage-include=src/experience/avatar-media.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test test/unit/avatar-media.test.js"
  },
  "keywords": [
    "kaltura",
    "avatar",
    "conversational-ai",
    "webrtc",
    "genie",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaltura/intelligent-agents-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/kaltura/intelligent-agents-sdk/issues"
  },
  "homepage": "https://github.com/kaltura/intelligent-agents-sdk#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "jsdom": "^29.0.0",
    "madge": "^8.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
