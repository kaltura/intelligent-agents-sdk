<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — @kaltura/intelligent-agents</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="icon" href="/assets/logo/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles.css">
  <script>
    // Set the theme before first paint — respects a saved choice, then
    // prefers-color-scheme, then defaults to dark (design doc §8).
    (function () {
      var saved = localStorage.getItem('theme');
      var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <script>
    // Nova's router/navigator read these globally rather than fetching the
    // route list — same data nav.js already drives the sidebar from (see
    // src/_data/routes.js). Bare, unprefixed URLs; runtime code applies its
    // own withPrefix() before fetch()/pushState() (see router.js).
    window.__SITE_ROUTES__ = {{ routes | dump | safe }};
    window.__SITE_PATH_PREFIX__ = {{ pathPrefix | dump | safe }};
  </script>
</head>
<body class="{{ bodyClass | default('') }}">
  <header class="site-header">
    <div style="display:flex;align-items:center;gap:0.75rem;">
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation" aria-expanded="false">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <a href="/" class="logo" aria-label="@kaltura/intelligent-agents home">
        <img src="/assets/logo/logo-horizontal-color.svg" alt="Kaltura" data-logo="light">
        <img src="/assets/logo/logo-horizontal-color-dark.svg" alt="Kaltura" data-logo="dark" style="display:none;">
      </a>
    </div>
    <div class="header-actions">
      <a class="gh-link" href="https://github.com/kaltura/intelligent-agents-sdk" target="_blank" rel="noopener">
        <span class="material-symbols-outlined" aria-hidden="true">code</span>
        GitHub
      </a>
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark/light theme">
        <span class="material-symbols-outlined" id="themeIcon" aria-hidden="true">dark_mode</span>
      </button>
    </div>
  </header>

  <nav class="sidebar" id="sidebar" aria-label="Documentation">
    <div class="nav-group">
      <ul>
        <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Home</a></li>
      </ul>
    </div>
    {% for section in nav %}
    <div class="nav-group">
      <div class="nav-group-label">{{ section.group }}</div>
      <ul>
        {% for item in section.pages %}
        <li><a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </nav>

  <main class="content-wrapper">
    {% if eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}
    {{ content | safe }}
  </main>

  <!-- Nova — one persistent widget, present on every page (see
       src/assets/nova/*.js). Lives outside <main> so client-side navigation
       (router.js) never touches it, keeping her live session alive across
       "page" changes on this static multi-page site. -->
  <div class="nova-widget" id="nova-widget">
    <div class="nova-video-wrap" id="nova-video-wrap">
      <video id="nova-video" autoplay playsinline></video>
      <div class="nova-placeholder" id="nova-placeholder" role="button" tabindex="0" aria-label="Talk to Nova — she knows this whole SDK.">
        <span class="material-symbols-outlined nova-placeholder-icon" aria-hidden="true">graphic_eq</span>
        Click to talk with Nova — she knows this whole SDK.
      </div>
      <div class="nova-disclosure hidden" id="nova-disclosure">You are talking with an AI avatar, not a human.</div>
      <div class="nova-disclosure-chip hidden" id="nova-disclosure-chip" title="You are talking with an AI avatar, not a human." aria-label="You are talking with an AI avatar, not a human.">AI</div>
      <button class="nova-chat-start" id="nova-chat-start" type="button">Prefer text? Chat without video</button>
    </div>
    <div class="nova-panel" id="nova-panel">
      <!-- Drawer-only header (chat mode renders the widget as a side drawer,
           see styles.css .drawer-mode). The video-wrap shrinks to the avatar
           circle beside this title; the sub-line doubles as the EU AI Act
           disclosure alongside the "AI" chip on the avatar itself. -->
      <div class="nova-drawer-head" id="nova-drawer-head">
        <span class="nova-drawer-title">Nova</span>
        <span class="nova-drawer-sub">AI assistant — knows this whole site</span>
      </div>
      <div class="nova-controls">
        <button class="nova-btn" id="nova-mute" disabled aria-label="Mute">
          <span class="material-symbols-outlined" aria-hidden="true" id="nova-mute-icon">mic</span>
        </button>
        <button class="nova-btn" id="nova-mode" disabled aria-label="Switch to live video" title="Switch to live video">
          <span class="material-symbols-outlined" aria-hidden="true" id="nova-mode-icon">videocam</span>
        </button>
        <button class="nova-btn" id="nova-new" disabled aria-label="Start a new conversation" title="Start a new conversation">
          <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
        </button>
        <button class="nova-btn" id="nova-end" disabled aria-label="End video — continue in chat" title="End video — continue in chat">
          <span class="material-symbols-outlined" aria-hidden="true">call_end</span>
        </button>
        <button class="nova-btn" id="nova-close" disabled aria-label="Close chat" title="Close chat">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>
      <div class="nova-status" id="nova-status" role="status" aria-live="polite"></div>
      <div class="nova-transcript" id="nova-transcript" role="log" aria-live="polite" aria-label="Conversation transcript"></div>
      <form class="nova-input-row" id="nova-input-row" autocomplete="off">
        <input type="text" id="nova-input" placeholder="Message Nova…" aria-label="Message Nova" maxlength="2000">
        <button class="nova-btn nova-send" id="nova-send" type="submit" aria-label="Send">
          <span class="material-symbols-outlined" aria-hidden="true">send</span>
        </button>
      </form>
      <p class="nova-drawer-note">Reloading starts a fresh chat. “New conversation” does the same without leaving the drawer.</p>
    </div>
    <!-- Docked bubble, no session yet: the mic circle starts a video call, so
         this badge is the only way in to text-only chat without expanding
         the flyout first — mirrors .nova-chat-start's hero-mode pill, sized
         for the corner of a small circle instead of overlaid on full video. -->
    <button class="nova-btn nova-dock-chat" id="nova-dock-chat" type="button" aria-label="Chat without video" title="Chat without video">
      <span class="material-symbols-outlined" aria-hidden="true">chat</span>
    </button>
  </div>
  <script type="module" src="/assets/nova/connect.js"></script>

  <script>
    (function () {
      var root = document.documentElement;
      var toggle = document.getElementById('themeToggle');
      var icon = document.getElementById('themeIcon');
      var lightLogo = document.querySelector('[data-logo="light"]');
      var darkLogo = document.querySelector('[data-logo="dark"]');

      function syncChrome() {
        var theme = root.getAttribute('data-theme');
        icon.textContent = theme === 'dark' ? 'dark_mode' : 'light_mode';
        if (lightLogo && darkLogo) {
          lightLogo.style.display = theme === 'dark' ? 'none' : 'block';
          darkLogo.style.display = theme === 'dark' ? 'block' : 'none';
        }
      }
      syncChrome();

      toggle.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        syncChrome();
      });

      var menuToggle = document.getElementById('menuToggle');
      var sidebar = document.getElementById('sidebar');
      menuToggle.addEventListener('click', function () {
        var open = sidebar.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', open);
      });
    })();
  </script>
</body>
</html>
